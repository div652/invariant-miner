# Per-user settings for dsh-bench-harness: copy to ~/.config/dsh-bench/local.env (chmod 600) and fill in YOUR values.
# Never commit the filled-in file. Values are file paths or endpoints, not the secrets themselves: each *_FILE points
# at a file (mode 600) that holds one key. dsh_bench reads this file; settings already in the environment win.

# --- Model endpoints (models/*.json, --endpoint) ---------------------------------------------------------------------
# cao: your CAO gateway's key file (the gateway itself runs on 127.0.0.1:4141).
DSH_BENCH_CAO_KEY_FILE=
# trapi: your TRAPI instance's Responses base URL (https://<trapi host>/<instance>/openai/v1) and the Azure CLI config
# dir of the account that has TRAPI access (az login there first; default: az's own ~/.azure).
TRAPI_BASE_URL=
AZURE_CONFIG_DIR=
# vscode: no credentials (your own VS Code + GH Copilot Server extension); vllm: none (local server, shared token).

# --- JobBench --------------------------------------------------------------------------------------------------------
# Web search: the key file the Exa relay on 127.0.0.1:8010 expects from clients (the relay holds the real Exa key).
DSH_BENCH_EXA_KEY_FILE=
# Grading: a judge_parallel.sh (runs job-bench-eval's run_judge.sh in parallel groups against your judge endpoint).
JOBBENCH_JUDGE_PARALLEL=
# Only for models/luna-proxy-high.json (agentic-evolution's model_serve proxy): its local token file.
DSH_BENCH_MODEL_SERVE_TOKEN_FILE=

# --- APEX-Agents -----------------------------------------------------------------------------------------------------
# Your own Financial Modeling Prep API key, in a file (chmod 600): the FMP app of the two banking worlds (244, 246)
# reads it. Required before running those worlds; never commit the key.
DSH_BENCH_FMP_KEY_FILE=
# SEC EDGAR asks every client to declare who it is: "<your name> <your email>". The Edgar SEC app of the two banking
# worlds sends it on each request. Required before running those worlds.
DSH_BENCH_EDGAR_USER_AGENT=
# Grading judge (benchmarks/apex-agents/grade.py): an OpenAI-compatible endpoint and its key file. Unset: CAO
# (http://127.0.0.1:4141/v1 with DSH_BENCH_CAO_KEY_FILE). The judge model is gemini-3.8-flash (grade.py --judge).
DSH_BENCH_JUDGE_BASE_URL=
DSH_BENCH_JUDGE_KEY_FILE=

# --- Harvey ----------------------------------------------------------------------------------------------------------
# Grading runs Harvey's judges through CAO with DSH_BENCH_CAO_KEY_FILE. compare_c0.py: your AHE campaign artifacts.
DSH_BENCH_C0_ARTIFACTS=
