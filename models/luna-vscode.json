{
  "provider": "luna-vscode",
  "display_name": "GPT-5.6 Luna (GH Copilot Server VS Code extension via the local shim)",
  "model": "gpt-5.6-luna",
  "api": "openai-completions",
  "base_url": "http://127.0.0.1:8032/v1",
  "api_key_file": "~/.config/dsh-bench/endpoint.token",
  "reasoning": "high",
  "reasoning_efforts": {
    "low": "low",
    "medium": "medium",
    "high": "high",
    "xhigh": "xhigh"
  },
  "context_window": 922000,
  "max_tokens": 128000,
  "input": [
    "text"
  ],
  "compat": {
    "supportsDeveloperRole": false,
    "supportsStore": false,
    "maxTokensField": "max_tokens",
    "thinkingFormat": "openai",
    "supportsReasoningEffort": true
  },
  "stream_idle_timeout_ms": 1800000
}
