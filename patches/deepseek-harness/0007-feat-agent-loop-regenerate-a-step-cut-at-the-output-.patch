diff --git a/packages/core/agent-loop/tests/max-tokens-retry.spec.ts b/packages/core/agent-loop/tests/max-tokens-retry.spec.ts
new file mode 100644
index 0000000000..55306de4dc
--- /dev/null
+++ b/packages/core/agent-loop/tests/max-tokens-retry.spec.ts
@@ -0,0 +1,139 @@
+import { describe, expect, it } from 'vitest'
+import { Context } from '@deepseek-ai/cordis'
+import LlmRuntime, { createUserMessage } from '@deepseek-ai/dsh-llm'
+import SessionStore, { SessionId, TurnEndReason } from '@deepseek-ai/dsh-session'
+import SystemPrompt from '@deepseek-ai/dsh-system-prompt'
+import ToolRuntime, { defineContentToolFixture } from '@deepseek-ai/dsh-tools'
+import AgentRegistry, { type Agent } from '@deepseek-ai/dsh-agent'
+
+import AgentLoop from '@deepseek-ai/dsh-agent-loop'
+import SessionProjectionRegistry from '@deepseek-ai/dsh-session-projection'
+import { MockAdapter, maxTokensResponse, textResponse, toolCallResponse } from './mock-adapter.ts'
+
+async function harness(adapter: MockAdapter, maxTokensRetries?: number) {
+  const ctx = new Context()
+  await ctx.plugin(LlmRuntime)
+  await ctx.plugin(SessionStore)
+  await ctx.plugin(SessionProjectionRegistry)
+  await ctx.plugin(SystemPrompt, { personaPrefix: '' })
+  await ctx.plugin(ToolRuntime)
+  await ctx.plugin(AgentRegistry)
+  await ctx.plugin(AgentLoop, maxTokensRetries === undefined ? { agents: [] } : { agents: [], maxTokensRetries })
+  ctx.llm.registerAdapter(['mock'], adapter)
+  return ctx
+}
+
+function waitForIdle(ctx: Context, agent: Agent): Promise<void> {
+  return new Promise((resolve) => {
+    const dispose = ctx.on('agent/status', ({ agent: subject, status }) => {
+      if (subject === agent && status === 'idle') {
+        dispose()
+        resolve()
+      }
+    })
+  })
+}
+
+async function run(ctx: Context, text = 'go'): Promise<{ agent: Agent; reasons: TurnEndReason[] }> {
+  const agent = await ctx.agentLoop.create(SessionId('max-tokens-retry'), { provider: 'mock', model: 'mock' })
+  const reasons: TurnEndReason[] = []
+  ctx.on('session/event', (_s, event) => { if (event.type === 'turn/end') reasons.push(event.data.reason) })
+  agent.followup(createUserMessage({ content: [{ type: 'text', text }], source: { kind: 'user' } }))
+  await waitForIdle(ctx, agent)
+  return { agent, reasons }
+}
+
+function eventsOf(agent: Agent, type: string) {
+  return agent.session.snapshotEvents().filter(e => e.type === type)
+}
+
+function retries(agent: Agent) {
+  return agent.session.snapshotEvents().flatMap(e => e.type === 'agent/max-tokens-retry' ? [e.data] : [])
+}
+
+function assistantTexts(agent: Agent): string[] {
+  return agent.session.deriveMessages()
+    .filter(m => m.role === 'assistant')
+    .flatMap(m => m.content.flatMap(b => b.type === 'text' ? [b.text] : []))
+}
+
+describe('agent loop maxTokensRetries', () => {
+  it('regenerates a step cut at the output ceiling and keeps the cut response log-only', async () => {
+    const adapter = new MockAdapter([maxTokensResponse('cut'), textResponse('done')])
+    const ctx = await harness(adapter, 3)
+    const { agent, reasons } = await run(ctx)
+
+    expect(adapter.requests).toHaveLength(2)
+    expect(adapter.requests[1]!.messages).toEqual(adapter.requests[0]!.messages)
+    expect(eventsOf(agent, 'step/start')).toHaveLength(1)
+    expect(eventsOf(agent, 'assistant/attempt').map(e => e.data)).toEqual([
+      expect.objectContaining({ turn: 1, step: 1 }),
+    ])
+    expect(retries(agent)).toEqual([
+      { turn: 1, step: 1, retry: 1, maxRetries: 3, outputTokens: 3 },
+    ])
+    expect(eventsOf(agent, 'assistant/message')).toHaveLength(1)
+    expect(assistantTexts(agent)).toEqual(['done'])
+    expect(reasons).toEqual([{ kind: 'completed' }])
+  })
+
+  it('ends the turn max-tokens with the last cut response once the retries run out', async () => {
+    const adapter = new MockAdapter([
+      maxTokensResponse('cut 1'),
+      maxTokensResponse('cut 2'),
+      maxTokensResponse('cut 3'),
+      maxTokensResponse('cut 4'),
+    ])
+    const ctx = await harness(adapter, 3)
+    const { agent, reasons } = await run(ctx)
+
+    expect(adapter.requests).toHaveLength(4)
+    expect(eventsOf(agent, 'assistant/attempt')).toHaveLength(3)
+    expect(retries(agent).map(r => r.retry)).toEqual([1, 2, 3])
+    expect(assistantTexts(agent)).toEqual(['cut 4'])
+    expect(reasons).toEqual([{ kind: 'max-tokens' }])
+  })
+
+  it('keeps the cut response as the step without the setting', async () => {
+    const adapter = new MockAdapter([maxTokensResponse('cut')])
+    const ctx = await harness(adapter)
+    const { agent, reasons } = await run(ctx)
+
+    expect(adapter.requests).toHaveLength(1)
+    expect(ctx.agentLoop.config.maxTokensRetries).toBe(0)
+    expect(retries(agent)).toHaveLength(0)
+    expect(eventsOf(agent, 'assistant/attempt')).toHaveLength(0)
+    expect(assistantTexts(agent)).toEqual(['cut'])
+    expect(reasons).toEqual([{ kind: 'max-tokens' }])
+  })
+
+  it('gives every step its own budget and runs the tool calls of the regenerated response', async () => {
+    const adapter = new MockAdapter([
+      maxTokensResponse('cut in step 1'),
+      toolCallResponse('c1', 'echo', { text: 'x' }),
+      maxTokensResponse('cut in step 2'),
+      textResponse('done'),
+    ])
+    const ctx = await harness(adapter, 1)
+    let executions = 0
+    ctx.tools.register(defineContentToolFixture({
+      name: 'echo',
+      description: '',
+      parameters: { text: { type: 'string' } },
+      async execute() {
+        executions += 1
+        return [{ type: 'text', text: 'echoed' }]
+      },
+    }))
+    const { agent, reasons } = await run(ctx)
+
+    expect(executions).toBe(1)
+    expect(retries(agent).map(r => [r.step, r.retry])).toEqual([[1, 1], [2, 1]])
+    expect(assistantTexts(agent)).toEqual(['done'])
+    expect(reasons).toEqual([{ kind: 'completed' }])
+  })
+
+  it('rejects a negative retry budget at load', async () => {
+    await expect(harness(new MockAdapter([]), -1)).rejects.toThrow()
+  })
+})
