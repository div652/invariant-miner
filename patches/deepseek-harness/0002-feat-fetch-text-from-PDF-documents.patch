+/**
+ * Parse one complete PDF and extract page text in source order. Parsing shares
+ * the fetch deadline and leaves no worker active after success or failure.
+ */
+async function extractPdf(
+  bytes: Uint8Array,
+  maxPages: number,
+  maxBodyChars: number,
+  signal: AbortSignal,
+): Promise<ExtractedPdf> {
+  let pdfjs: PdfJsModule
