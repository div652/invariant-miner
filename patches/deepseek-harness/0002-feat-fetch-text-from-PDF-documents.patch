+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+import { Response } from 'undici'
+import { HttpFetchProvider } from '@deepseek-ai/dsh-web-fetch-http'
+import type { HttpFetchLimits } from '@deepseek-ai/dsh-web-fetch-http'
+import { publicHttpNetwork } from '../src/network.ts'
+import { textPdf } from './pdf-fixtures.ts'
+
+const pdfjs = vi.hoisted(() => ({
+  getDocument: vi.fn(),
+  PasswordException: class PasswordException extends Error {},
+}))
+
+vi.mock('pdfjs-dist/legacy/build/pdf.mjs', () => ({
+  getDocument: pdfjs.getDocument,
+  PasswordException: pdfjs.PasswordException,
+  VerbosityLevel: { ERRORS: 0 },
+}))
+
+const limits: HttpFetchLimits = {
+  maxResponseBytes: 5_000_000,
+  maxBodyChars: 100_000,
+  maxPdfPages: 100,
+  timeoutMs: 5_000,
+  maxRedirects: 5,
+  userAgent: 'test-agent/1.0',
+}
+
+beforeEach(() => {
+  pdfjs.getDocument.mockReset()
+})
+
+afterEach(() => {
+  vi.useRealTimers()
+  vi.restoreAllMocks()
+})
+
+function provider(overrides: Partial<HttpFetchLimits> = {}): HttpFetchProvider {
+  return new HttpFetchProvider(
+    { ...limits, ...overrides },
+    async () => [{ address: '127.0.0.1', family: 4 }],
+  )
+}
+
+function stubResponse(response: Response): ReturnType<typeof vi.fn> {
+  const close = vi.fn(async () => {})
+  vi.spyOn(publicHttpNetwork, 'request').mockResolvedValue({ response, close })
+  return close
+}
+
+function pdfResponse(): Response {
+  return new Response(textPdf('ignored'), { headers: { 'content-type': 'application/pdf' } })
+}
+
+describe('PDF parser cancellation', () => {
+  it('maps caller abort during PDF parsing and waits for parser destruction', async () => {
+    const destroy = vi.fn(async () => {})
+    pdfjs.getDocument.mockReturnValue({ promise: new Promise(() => {}), destroy })
+    const close = stubResponse(pdfResponse())
+    const controller = new AbortController()
+
+    const pending = provider().fetch({ url: 'http://127.0.0.1:9/document.pdf' }, controller.signal)
+    await vi.waitFor(() => { expect(pdfjs.getDocument).toHaveBeenCalledOnce() })
+    controller.abort('stop')
+
+    await expect(pending).rejects.toThrow(expect.objectContaining({ code: 'WEB_ABORTED' }))
+    expect(destroy).toHaveBeenCalledOnce()
+    expect(close).toHaveBeenCalledOnce()
+  })
+
+  it('maps the provider deadline during PDF parsing and waits for parser destruction', async () => {
+    vi.useFakeTimers()
+    const destroy = vi.fn(async () => {})
+    pdfjs.getDocument.mockReturnValue({ promise: new Promise(() => {}), destroy })
+    const close = stubResponse(pdfResponse())
+
+    const pending = provider({ timeoutMs: 20 }).fetch({ url: 'http://127.0.0.1:9/document.pdf' })
+    const rejection = expect(pending).rejects.toThrow(expect.objectContaining({ code: 'WEB_FETCH_TIMEOUT' }))
+    await vi.advanceTimersByTimeAsync(0)
+    expect(pdfjs.getDocument).toHaveBeenCalledOnce()
+    await vi.advanceTimersByTimeAsync(20)
+
+    await rejection
+    expect(destroy).toHaveBeenCalledOnce()
+    expect(close).toHaveBeenCalledOnce()
+  })
+
+  it('maps an abort between the body read and parser startup', async () => {
+    const controller = new AbortController()
+    const bytes = new Uint8Array(textPdf('ignored'))
+    let reads = 0
+    const reader = {
+      read: vi.fn(async () => {
+        if (reads++ === 0) return { done: false as const, value: bytes }
+        controller.abort('stop before parse')
+        return { done: true as const, value: undefined }
+      }),
+      cancel: vi.fn(async () => {}),
+    }
+    const response = {
+      status: 200,
+      headers: new Headers({ 'content-type': 'application/pdf' }),
+      body: { getReader: () => reader },
+    } as unknown as Response
+    stubResponse(response)
+
+    await expect(provider().fetch({ url: 'http://127.0.0.1:9/document.pdf' }, controller.signal))
+      .rejects.toThrow(expect.objectContaining({ code: 'WEB_ABORTED' }))
+    expect(pdfjs.getDocument).not.toHaveBeenCalled()
+  })
+})
+
+describe('PDF text normalization', () => {
+  it('ignores marked-content controls, normalizes whitespace, and preserves line breaks', async () => {
+    const cleanup = vi.fn()
+    const destroy = vi.fn(async () => {})
+    pdfjs.getDocument.mockReturnValue({
+      promise: Promise.resolve({
+        numPages: 1,
+        getPage: async () => ({
+          cleanup,
+          getTextContent: async () => ({
+            items: [
+              { type: 'beginMarkedContent', id: 'section' },
+              { str: ' First   line ', hasEOL: true },
+              { str: '   ', hasEOL: false },
+              { str: 'Second line', hasEOL: false },
+            ],
+          }),
+        }),
+      }),
+      destroy,
+    })
+    stubResponse(pdfResponse())
+
+    await expect(provider().fetch({ url: 'http://127.0.0.1:9/document.pdf' }))
+      .resolves.toMatchObject({
+        body: { kind: 'pdf', pages: ['First line\nSecond line'], pageCount: 1 },
+        truncated: false,
+      })
+    expect(cleanup).toHaveBeenCalledOnce()
+    expect(destroy).toHaveBeenCalledOnce()
+  })
+})
