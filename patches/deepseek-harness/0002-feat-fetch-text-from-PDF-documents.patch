+/** Normalize PDF.js text items into deterministic lines for one page. */
+function normalizePdfPageText(items: PdfTextContent['items']): string {
+  const lines: string[] = []
+  let line: string[] = []
+  for (const item of items) {
+    if (!('str' in item)) continue
+    const text = item.str.replace(/\s+/gu, ' ').trim()
+    if (text.length > 0) line.push(text)
+    if (item.hasEOL) {
+      lines.push(line.join(' '))
+      line = []
+    }
+  }
+  if (line.length > 0) lines.push(line.join(' '))
+  return lines.join('\n').trim()
