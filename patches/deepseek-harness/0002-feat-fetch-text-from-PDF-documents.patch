+    pdfjs = await raceWithSignal(import('pdfjs-dist/legacy/build/pdf.mjs'), signal)
+  } catch (error: unknown) {
+    if (signal.aborted) throw translateAbortOrNetwork(error, signal)
+    throw new WebError(`PDF parser failed to load: ${String(error)}`, 'WEB_PROVIDER_ERROR', { cause: error })
+  }
